{
  "name": "sample-mastra-app",
  "version": "1.0.0",
  "description": "A general-purpose Mastra agent with a local workspace, shell tools, memory, task tracking, web access, and recurring schedules.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "dev": "mastra dev",
    "voice:dev": "node --env-file=.env --env-file-if-exists=.env.local --import tsx src/mastra/voice-worker.ts dev",
    "web:dev": "pnpm --filter web dev",
    "build": "mastra build",
    "start": "mastra start"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.1",
    "@livekit/agents-plugin-livekit": "^1.9.1",
    "@livekit/agents-plugin-silero": "^1.9.1",
    "@mastra/agent-browser": "^0.5.3",
    "@mastra/core": "1.74.0",
    "@mastra/livekit": "^0.4.2",
    "@mastra/memory": "1.35.0",
    "@mastra/observability": "1.18.3",
    "@mastra/pg": "^1.29.0",
    "@onkernel/sdk": "^0.119.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "latest",
    "mastra": "1.32.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
